{
  "name": "kok-avi-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kök Avı — vakıf eserlerini çocuklara günlük mikro derslerle öğreten PWA. KÖK & KOD Hackathon MVP.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "seed": "tsx server/seed/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "dogrula": "npm run typecheck && npm run test && npm run build",
    "build:vercel": "esbuild deploy/vercel-giris.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/index.mjs --packages=external && cp server/db/schema.sql server/db/auth-schema.sql api/"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
