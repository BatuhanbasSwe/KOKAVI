# Kök Avı ortam değişkenleri — bu dosyayı .env olarak kopyala ve doldur.
# .env gitignore'dadır; anahtarı asla commit etme ve sohbete yapıştırma.

# AI soru taslağı (`npm run soru:taslak`) için. İkisi de boşsa hat çalışmaz.
# GEMINI_API_KEY doluysa Gemini kullanılır; yoksa ANTHROPIC_API_KEY doluysa Claude.
# Gemini anahtarı: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# İsteğe bağlı: model adları
# KOKAVI_GEMINI_MODEL=gemini-3.8-flash
# KOKAVI_SOR_MODEL=claude-haiku-5-5
