# Kök Avı ortam değişkenleri — bu dosyayı .env olarak kopyala ve doldur.
# .env gitignore'dadır; anahtarı asla commit etme ve sohbete yapıştırma.

# Kaynaklı soru-cevap ("Köstik'e sor"). Boşsa özellik kapalı kalır, arama çalışır.
ANTHROPIC_API_KEY=

# İsteğe bağlı: soru-cevap modeli (varsayılan claude-haiku-5-5)
# KOKAVI_SOR_MODEL=claude-haiku-5-5
